concurrent = 4
check_interval = 0

[[runners]]
  name = "{{ runner_name }}"
  url = "{{ gitlab_url }}"
  executor = "{{ runner_executor }}"
  tags = [{{ runner_tags | map('to_json') | join(', ') }}]

  [runners.docker]
    image = "{{ runner_docker_image }}"
    privileged = false
    disable_entrypoint_overwrite = false
    oom_kill_disable = false
    disable_cache = false
    volumes = ["/var/run/docker.sock:/var/run/docker.sock", "/cache"]
    shm_size = 0